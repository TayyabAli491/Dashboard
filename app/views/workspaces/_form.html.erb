<%= form_with model: workspace, class: "flex flex-col gap-6 mt-4" do |form| %>
  <div>
    <%= form.label :name, class: "card-meta-label block mb-1.5" %>
    <%= form.text_field :name, required: true, class: "w-full bg-[#F7F5F1] border border-[#E8E4DD] rounded-lg px-3 py-2.5 text-[14px] text-[#1A1A1A] placeholder-[#9E9891] focus:outline-none focus:border-[#C8C3BB] focus:bg-white transition-all shadow-sm", placeholder: "e.g., Cansat Project Alpha" %>
    <% workspace.errors.full_messages_for(:name).each do |error_message| %>
      <p class="mt-1.5 text-[12px] text-[#A32D2D] font-medium"><%= error_message %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :description, class: "card-meta-label block mb-1.5" %>
    <%= form.text_area :description, rows: 4, class: "w-full bg-[#F7F5F1] border border-[#E8E4DD] rounded-lg px-3 py-2.5 text-[14px] text-[#1A1A1A] placeholder-[#9E9891] focus:outline-none focus:border-[#C8C3BB] focus:bg-white transition-all shadow-sm resize-none", placeholder: "Brief description of this workspace's purpose..." %>
    <% workspace.errors.full_messages_for(:description).each do |error_message| %>
      <p class="mt-1.5 text-[12px] text-[#A32D2D] font-medium"><%= error_message %></p>
    <% end %>
  </div>

  <div class="flex items-center gap-3 py-1">
    <%= form.check_box :is_public, class: "h-4 w-4 rounded border-[#E8E4DD] text-[#1A1A1A] focus:ring-[#1A1A1A] transition-colors cursor-pointer" %>
    <%= form.label :is_public, "Make this workspace public", class: "text-[13px] font-medium text-[#1A1A1A] cursor-pointer" %>
    <% workspace.errors.full_messages_for(:is_public).each do |error_message| %>
      <p class="mt-1.5 text-[12px] text-[#A32D2D] font-medium"><%= error_message %></p>
    <% end %>
  </div>

  <div class="flex items-center gap-4 pt-5 border-t border-[#E8E4DD] mt-2">
    <%= form.submit class: "btn-new cursor-pointer border-0" %>
    <%= button_tag "Cancel", type: "button", onclick: "this.closest('turbo-frame').innerHTML=''", class: "text-[13px] bg-transparent border-0 font-medium text-[#6B6560] hover:text-[#1A1A1A] transition-colors cursor-pointer" %>
  </div>
<% end %>
