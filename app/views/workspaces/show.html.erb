<div class="page-wrap">
  <%= render "shared/nav" %>

  <main class="main-content">
    <div class="topbar">
      <div>
        <div class="mb-5">
          <%= link_to workspaces_path, class: "inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider text-[#6B6560] bg-[#E8E4DD]/50 hover:bg-[#E8E4DD] hover:text-[#1A1A1A] px-2.5 py-1.5 rounded-lg transition-colors border border-transparent hover:border-[#C8C3BB]" do %>
            <i class="fa-solid fa-arrow-left text-[9px]"></i> All Workspaces
          <% end %>
        </div>
        <div class="page-eyebrow">Workspace Overview</div>
        <h1 class="page-title"><%= @workspace.name %></h1>
      </div>
      <!-- Right side reserved for primary actions -->
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      
      <!-- MAIN COLUMN -->
      <div class="flex flex-col gap-6 lg:col-span-2">
        
        <!-- API Credentials Card -->
        <div class="card p-0" data-controller="reveal clipboard" data-reveal-api-key-value="<%= @workspace.api_key %>" data-clipboard-text-value="<%= @workspace.api_key %>">
          <div class="card-accent teal"></div>
          <div class="p-6">
            <div class="card-top mb-5">
               <div class="flex items-center gap-3">
                 <div class="card-icon">
                   <i class="fa-solid fa-key"></i>
                 </div>
                 <div>
                   <div class="card-title text-base sm:text-lg mb-0.5 mt-0">API Credentials</div>
                   <div class="text-[11px] text-[#9E9891]">Authenticate devices sending telemetry data.</div>
                 </div>
               </div>
            </div>

            <div class="bg-[#F7F5F1] rounded-lg border border-[#E8E4DD] p-4 flex flex-col gap-4 mb-5">
              <div>
                <div class="card-meta-label">API KEY</div>
                <div class="flex items-center justify-between gap-4 mt-1">
                  <div class="font-mono text-[#1A1A1A] font-medium text-[13px] tracking-wider" data-reveal-target="value">••••••••••••••••</div>
                  <div class="flex items-center gap-2">
                     <button type="button" class="btn-secondary text-[10px]" data-reveal-target="button" data-action="reveal#toggle">
                       <i class="fa-regular fa-eye"></i> Reveal
                     </button>
                     <button type="button" class="btn-secondary text-[10px]" data-clipboard-target="button" data-action="clipboard#copy">
                       <i class="fa-regular fa-copy"></i> Copy
                     </button>
                  </div>
                </div>
              </div>

              <div class="pt-4 border-t border-[#E8E4DD]">
                <div class="card-meta-label">ENDPOINT URL</div>
                <div class="font-mono text-[#1A1A1A] text-[12px] mt-2 break-all bg-white px-3 py-2 rounded border border-[#E8E4DD] inline-block w-full">
                  <%= "#{request.base_url}/api/workspaces/#{@workspace.id}/telemetry" %>
                </div>
              </div>
            </div>

            <div>
               <%= button_to workspace_path(@workspace, regenerate_api_key: true), method: :patch, data: { turbo_confirm: "This will invalidate the current key immediately. Only do this if your key is compromised. Continue?" }, class: "inline-flex items-center gap-2 text-[11px] font-medium text-[#A32D2D] hover:bg-[#FCEBEB] px-3 py-2 rounded-md transition-colors w-auto border border-transparent hover:border-[#F7C1C1] cursor-pointer" do %>
                 <i class="fa-solid fa-rotate"></i> Regenerate API Key
               <% end %>
            </div>
          </div>
        </div>

        <!-- Payload Schema Card -->
        <div class="card p-0">
          <div class="card-accent blue"></div>
          <div class="p-6">
            <div class="flex items-center justify-between mb-5">
              <div class="flex items-center gap-3">
                <div class="card-icon">
                  <i class="fa-solid fa-database"></i>
                </div>
                <div>
                  <div class="card-title text-base sm:text-lg mb-0.5 mt-0">Payload Schema</div>
                  <div class="text-[11px] text-[#9E9891]">Defines how telemetry parameters are parsed.</div>
                </div>
              </div>
              <%= link_to edit_workspace_payload_schema_path(@workspace), class: "btn-secondary !px-3 !py-1.5" do %>
                <i class="fa-solid fa-pen"></i> Edit
              <% end %>
            </div>

            <% if @workspace.payload_schema_defined? %>
              <div class="overflow-hidden rounded-lg border border-[#E8E4DD]">
                <table class="w-full text-left border-collapse">
                  <thead class="bg-[#F7F5F1] text-[10px] font-semibold text-[#B5B0A8] uppercase tracking-wider">
                    <tr>
                      <th class="px-4 py-3 border-b border-[#E8E4DD]">Key</th>
                      <th class="px-4 py-3 border-b border-[#E8E4DD]">Type</th>
                      <th class="px-4 py-3 border-b border-[#E8E4DD]">Unit</th>
                      <th class="px-4 py-3 border-b border-[#E8E4DD]">Alias</th>
                    </tr>
                  </thead>
                  <tbody class="text-[13px] text-[#1A1A1A] divide-y divide-[#E8E4DD]">
                    <% @workspace.payload_schema.fields.each do |field| %>
                      <tr class="hover:bg-[#F7F5F1] transition-colors">
                        <td class="px-4 py-2.5 font-mono text-[12px]"><%= field["key"] %></td>
                        <td class="px-4 py-2.5"><span class="bg-gray-100 px-2 py-0.5 rounded text-[10px] border border-gray-200 uppercase font-medium"><%= field["type"] %></span></td>
                        <td class="px-4 py-2.5 text-[#6B6560]"><%= field["unit"].presence || "-" %></td>
                        <td class="px-4 py-2.5 text-[#6B6560]"><%= field["alias"].presence || "-" %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% else %>
              <div class="bg-[#FAEEDA] border border-[#FAC775] text-[#854F0B] rounded-lg px-4 py-4 flex items-start gap-3">
                 <i class="fa-solid fa-triangle-exclamation mt-0.5"></i>
                 <div>
                   <div class="text-[13px] font-medium mb-1">Schema not defined</div>
                   <div class="text-[12px] opacity-80">You won't be able to ingest or monitor telemetry data without defining the data structure first.</div>
                 </div>
              </div>
            <% end %>
          </div>
        </div>

      </div>

      <!-- SIDE COLUMN -->
      <div class="flex flex-col gap-6">

        <% active_session = @workspace.sessions.order(started_at: :desc).detect(&:session_active?) %>
        <% if active_session.present? %>
          <div class="card p-0">
            <div class="card-accent amber"></div>
            <div class="p-6">
              <div class="card-meta-label mb-3">Live Session</div>
              <div class="flex items-center gap-3 mb-1">
                <span class="relative flex h-3 w-3">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                </span>
                <div class="text-[15px] font-semibold text-[#1A1A1A] truncate"><%= active_session.name %></div>
              </div>
              <div class="text-[11px] text-[#9E9891]">
                 Started <%= active_session.started_at&.strftime("%b %-d, %Y %H:%M") %>
              </div>
              
              <%= link_to session_path(active_session), class: "btn-primary w-full mt-5 justify-center" do %>
                 <i class="fa-solid fa-satellite-dish"></i>
                 Monitor Live
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="card p-0">
          <div class="p-6">
            <div class="card-meta-label mb-2 text-center w-full block">Total Telemetry</div>
            <div class="text-4xl font-semibold text-[#1A1A1A] text-center my-3"><%= number_with_delimiter(@workspace.telemetry_record_count) %></div>
            <div class="text-[10px] text-[#9E9891] text-center mb-5 tracking-wider uppercase">Records Across All Sessions</div>
            <%= link_to workspace_sessions_path(@workspace), class: "btn-secondary w-full justify-center" do %>
              <i class="fa-solid fa-list-ul"></i> View History
            <% end %>
          </div>
        </div>

        <div class="card p-0 border-dashed border-2 bg-transparent shadow-none hover:shadow-none text-center flex flex-col items-center justify-center min-h-[180px]">
          <div class="p-6 flex flex-col items-center">
            <div class="w-10 h-10 rounded-full bg-[#E8E4DD] text-[#9E9891] flex items-center justify-center mb-3">
               <i class="fa-solid fa-chart-pie"></i>
            </div>
            <h3 class="text-[13px] font-medium text-[#1A1A1A] mb-1">Dashboard Widgets</h3>
            <p class="text-[11px] text-[#9E9891] leading-relaxed">Visualizations and graphs will be introduced in Phase 4 of development.</p>
          </div>
        </div>

      </div>

    </div>
  </main>
</div>
