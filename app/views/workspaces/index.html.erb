<div class="page-wrap">
  <%= render "shared/nav" %>

  <main class="main-content">
    <div class="topbar">
      <div>
        <div class="page-eyebrow">Dashboard</div>
        <h1 class="page-title">My Workspaces <em>&amp; Projects</em></h1>
      </div>
      <%= link_to new_workspace_path, data: { turbo_frame: "remote_modal" }, class: "btn-new" do %>
        <i class="fa-solid fa-plus"></i>
        New Workspace
      <% end %>
    </div>

    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-label">Total Workspaces</div>
        <div class="stat-val"><%= @workspaces.count %></div>
        <div class="stat-sub"><%= @workspaces.count { |w| w.payload_schema_defined? } %> with active schema</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Total Records</div>
        <div class="stat-val"><%= number_with_delimiter(@workspaces.sum { |w| w.telemetry_record_count.to_i }) %></div>
        <div class="stat-sub">across all workspaces</div>
      </div>
      <div class="stat-card">
        <div class="stat-label">Devices Online</div>
        <div class="stat-val">4</div>
        <div class="stat-sub">last seen &lt; 5 min ago</div>
      </div>
    </div>

    <div class="section-header">
      <div class="section-title">All Projects</div>
      <div class="filter-pills">
        <div class="pill active">All</div>
        <div class="pill">Active</div>
        <div class="pill">Schema Missing</div>
      </div>
    </div>

    <div class="cards-grid">
      <% if @workspaces.any? %>
        <%= render partial: "workspaces/workspace", collection: @workspaces %>
      <% else %>
        <div class="empty-state">
          <div class="empty-ring">
            <i class="fa-solid fa-satellite-dish fa-2x"></i>
          </div>
          <div class="empty-title">No Workspaces Found</div>
          <div class="empty-sub">Configure your first workspace to start interpreting telemetry.</div>
        </div>
      <% end %>
    </div>
  </main>
</div>
