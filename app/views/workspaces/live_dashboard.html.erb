<div class="fixed inset-0 z-[100] bg-[#0B0C10] overflow-hidden flex flex-col font-mono" 
     style="background-image: radial-gradient(rgba(193, 68, 14, 0.25) 1.5px, transparent 1.5px); background-size: 32px 32px;"
     data-controller="dashboard" 
     data-dashboard-workspace-id-value="<%= @workspace.id %>"
     data-dashboard-edit-mode-value="false">

  <%# Dynamic Background Layer %>
  <% if @workspace.dashboard_theme == 'video' && @workspace.background_video.attached? %>
    <video src="<%= url_for(@workspace.background_video) %>" class="fixed inset-0 w-full h-full object-cover z-0 opacity-100 pointer-events-none" autoplay loop muted playsinline></video>
  <% end %>

  <%# Subdued Full Screen Designer Header - Mars Edition %>
  <div class="absolute top-0 left-0 w-full flex justify-between items-center px-8 py-6 z-20 pointer-events-auto bg-gradient-to-b from-[#0B0C10] to-transparent">
    <div class="flex items-center gap-4">
      <h1 class="text-2xl font-bold tracking-widest text-[#E5E5E5] uppercase"><%= @workspace.name %> <span class="text-[#C1440E] opacity-70">/// ORBITAL</span></h1>
      <% if @active_session %>
        <div class="px-3 py-1 text-xs font-bold text-[#E77D11] border border-[#E77D11] rounded-sm bg-[#E77D11]/10 flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#E77D11] animate-pulse"></span> <%= @active_session.name %> (LIVE)</div>
      <% else %>
        <div class="px-3 py-1 text-xs font-bold text-[#666] border border-[#444] rounded-sm flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-[#666]"></span> NO UPLINK</div>
      <% end %>
    </div>
    
    <button onclick="window.close()" class="px-4 py-2 text-xs font-bold tracking-widest text-[#B5B0A8] border border-[#2A2B30] hover:border-[#C1440E] hover:text-[#C1440E] transition-all bg-[#121318]/80 backdrop-blur-sm rounded-sm cursor-pointer">
      [ ABORT ]
    </button>
  </div>

  <%# Live Grid Configuration %>
  <div class="pt-24 px-8 pb-8 h-full w-full relative z-10">
    <div class="grid-stack flex-1 w-full h-full" data-dashboard-target="grid">
      <% @workspace.parsed_dashboard_widgets.each do |widget| %>
        <div class="grid-stack-item pointer-events-none" 
             gs-x="<%= widget['grid']['x'] %>" 
             gs-y="<%= widget['grid']['y'] %>" 
             gs-w="<%= widget['grid']['w'] %>" 
             gs-h="<%= widget['grid']['h'] %>">
             
          <div class="grid-stack-item-content p-4 flex flex-col justify-center items-center bg-[#121318]/90 backdrop-blur-md border border-[#2A2B30] shadow-[0_0_15px_rgba(193,68,14,0.03)] rounded-lg relative overflow-hidden">
            <%# Mars Glow Edge Effect %>
            <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-[#C1440E]/40 to-transparent"></div>
            
            <div class="font-bold text-[#E5E5E5] absolute top-3 left-4 opacity-70 tracking-widest uppercase text-[10px]"><%= widget['label'] %></div>

            <% if widget['type'] == 'Value Card' %>
              <div class="flex flex-col items-center justify-center w-full h-full pt-4"
                   data-controller="value-card" 
                   data-action="telemetry:received@document->value-card#update" 
                   data-value-card-data-key-value="<%= widget['label'].downcase %>">
                   
                <div data-value-card-target="value" class="text-5xl text-[#E5E5E5] font-mono font-bold transition-colors duration-300 drop-shadow-md">--</div>
                <div data-value-card-target="status" class="text-[9px] font-semibold text-[#C1440E] uppercase tracking-[0.25em] mt-3 animate-pulse">[ AWAITING PING ]</div>
              </div>
            <% else %>
              <div class="w-12 h-12 rounded bg-[#1A1C23] border border-[#2A2B30] flex items-center justify-center mb-3 text-[#E77D11]">
                <i class="fa-solid fa-shapes text-lg drop-shadow-[0_0_8px_rgba(231,125,17,0.5)]"></i>
              </div>
              <div class="text-[10px] font-semibold text-[#C1440E] uppercase tracking-[0.2em] mt-2 animate-pulse">[ AWAITING PING ]</div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
