<% content_for :head do %>
  <%= stylesheet_link_tag "static_theme", "data-turbo-track": "reload" %>
<% end %>

<% widgets = @workspace.parsed_dashboard_widgets %>

<div class="fixed inset-0 z-[100] cansat-dashboard overflow-hidden flex flex-col"
     data-controller="dashboard"
     data-dashboard-workspace-id-value="<%= @workspace.id %>"
     data-dashboard-edit-mode-value="false">

  <% if @workspace.dashboard_theme == 'video' && @workspace.background_video.attached? %>
    <video src="<%= url_for(@workspace.background_video) %>"
           class="fixed inset-0 w-full h-full object-cover z-0 opacity-30 pointer-events-none"
           autoplay loop muted playsinline></video>
  <% end %>

  <%# Header %>
  <header class="live-header">
    <div class="live-header-left">
      <div class="live-brand">
        <div class="live-brand-mark"><i class="fa-solid fa-satellite-dish"></i></div>
        <div>
          <div class="live-brand-eyebrow">Live Telemetry</div>
          <div class="live-brand-title"><%= @workspace.name %></div>
        </div>
      </div>
    </div>

    <div class="live-header-center">
      <div class="live-clock" data-controller="clock" data-clock-target="display">--:--:-- UTC</div>
    </div>

    <div class="live-header-right">
      <% if @active_session %>
        <div class="live-session">
          <span class="live-dot" style="background:#10B981"></span>
          <div class="text-left leading-tight">
            <div class="text-[9px] text-[rgba(229,229,229,0.5)] uppercase tracking-widest">Session</div>
            <div class="text-[12px] font-semibold"><%= @active_session.name %></div>
          </div>
        </div>
      <% else %>
        <div class="live-session live-session-idle">
          <span class="live-dot" style="background:#F59E0B"></span>
          <div class="text-left leading-tight">
            <div class="text-[9px] text-[rgba(229,229,229,0.5)] uppercase tracking-widest">Session</div>
            <div class="text-[12px] font-semibold">Idle</div>
          </div>
        </div>
      <% end %>

      <%= link_to workspace_path(@workspace), class: "live-header-btn" do %>
        <i class="fa-solid fa-pen text-[11px]"></i> Edit Layout
      <% end %>
    </div>
  </header>

  <%# Grid %>
  <main class="live-main">
    <% if widgets.empty? %>
      <div class="live-empty">
        <div class="live-empty-icon"><i class="fa-solid fa-border-all"></i></div>
        <h2 class="live-empty-title">No widgets configured</h2>
        <p class="live-empty-sub">Open the layout editor and add widgets bound to your payload schema fields.</p>
        <%= link_to "Open Editor", workspace_path(@workspace), class: "live-empty-btn" %>
      </div>
    <% else %>
      <div class="grid-stack live-grid"
           data-dashboard-target="grid">
        <% widgets.each do |widget| %>
          <%= render "widgets/#{widget['type']}", widget: widget, workspace: @workspace %>
        <% end %>
      </div>
    <% end %>
  </main>
</div>
