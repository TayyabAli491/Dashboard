<%# CanSat Live Dashboard — clean orchestration view.
    Widgets live in: app/views/workspaces/widgets/_*.html.erb %>

<% content_for :head do %>
  <%= stylesheet_link_tag "static_theme", "data-turbo-track": "reload" %>
<% end %>
<div class="fixed inset-0 z-[100] bg-[#050810] cansat-dashboard overflow-hidden flex flex-col"
     style="background-image: radial-gradient(rgba(99,102,241,0.10) 1.5px, transparent 1.5px); background-size:32px 32px;"
     data-controller="dashboard"
     data-dashboard-workspace-id-value="<%= @workspace.id %>"
     data-dashboard-edit-mode-value="false">

  <%# Background video (optional) %>
  <% if @workspace.dashboard_theme == 'video' && @workspace.background_video.attached? %>
    <video src="<%= url_for(@workspace.background_video) %>"
           class="fixed inset-0 w-full h-full object-cover z-0 pointer-events-none"
           autoplay loop muted playsinline>
    </video>
  <% end %>

  <%# ——— HEADER ——— %>
  <%= render "workspaces/widgets/dashboard_header", workspace: @workspace, active_session: @active_session %>

  <%# ——— MAIN LAYOUT ——— %>
  <div class="pt-16 px-5 pb-5 h-full w-full relative z-10 flex flex-col gap-4">

    <%# TOP ROW: CanSat 3D (left) | empty center | GPS (right) %>
    <div class="flex gap-4 flex-1 min-h-0">

      <%= render "workspaces/widgets/attitude_widget", workspace_id: @workspace.id %>

      <%# Center — shows raw background + live clock %>
      <div class="flex-1 min-w-0 flex flex-col items-center justify-center gap-3 opacity-60">
        <div class="text-center">
          <div class="text-[0.55rem] tracking-[0.35em] text-[#6366F1]/60 uppercase mb-2">// Telemetry Feed //</div>
          <div class="text-[0.5rem] tracking-[0.2em] text-[#444] uppercase" id="center-clock">00:00:00 UTC</div>
        </div>
        <div style="width:1px; height:60px; background: linear-gradient(to bottom, transparent, rgba(99,102,241,0.3), transparent);"></div>
        <div class="text-[0.48rem] tracking-[0.18em] text-[#333] uppercase">ARCKONE v2.1 · CANSAT</div>
      </div>

      <%= render "workspaces/widgets/gps_widget", workspace_id: @workspace.id %>

    </div><!-- /top row -->

    <%# BOTTOM ROW: 4 sensor cards, equal-width grid %>
    <div class="bottom-scroller" style="flex-shrink:0; height:230px;">
      <%= render "workspaces/widgets/magnetometer_widget" %>
      <%= render "workspaces/widgets/gas_widget",         workspace_id: @workspace.id %>
      <%= render "workspaces/widgets/temperature_widget" %>
      <%= render "workspaces/widgets/pressure_widget" %>
    </div>

  </div><!-- /main layout -->
</div>

<%# ——— TELEMETRY ANIMATION SCRIPT ——— %>
<%# Drives dummy values for all widgets. Remove / disable once live hardware is connected. %>
<script>
document.addEventListener("DOMContentLoaded", () => {

  // UTC clock in center panel
  const clockEl = document.getElementById("center-clock");
  function tick() { if (clockEl) clockEl.textContent = new Date().toUTCString().slice(17,25) + " UTC"; }
  setInterval(tick, 1000); tick();

  // ── Utility: render a rolling SVG line + area chart ──
  function renderChart(svgId, lineId, areaId, data, minY, maxY) {
    const svg = document.getElementById(svgId);
    if (!svg) return;
    const W = svg.clientWidth  || svg.parentElement.clientWidth  || 280;
    const H = svg.clientHeight || svg.parentElement.clientHeight || 60;
    if (W < 2 || H < 2 || data.length < 2) return;
    const n = data.length;
    const pts = data.map((v, i) => {
      const x = (i / (n - 1)) * W;
      const y = H - Math.max(0, Math.min(1, (v - minY) / (maxY - minY))) * H * 0.9;
      return [x, y];
    });
    const linePath = pts.map((p, i) => (i === 0 ? "M" : "L") + p[0].toFixed(1) + "," + p[1].toFixed(1)).join(" ");
    const areaPath = linePath + " L" + W + "," + H + " L0," + H + " Z";
    svg.setAttribute("viewBox", "0 0 " + W + " " + H);
    const lineEl = document.getElementById(lineId);
    const areaEl = document.getElementById(areaId);
    if (lineEl) lineEl.setAttribute("d", linePath);
    if (areaEl) areaEl.setAttribute("d", areaPath);
  }

  // ── Magnetometer / Compass ──
  let heading = 137;
  const compassNeedle = document.getElementById("compass-needle");
  const dirs = ["N","NE","E","SE","S","SW","W","NW"];
  setInterval(() => {
    heading = (heading + (Math.random()*8-4) + 360) % 360;
    const deg = document.getElementById("compass-deg");
    const dir = document.getElementById("compass-dir");
    const mx  = document.getElementById("mag-x");
    const my  = document.getElementById("mag-y");
    const mz  = document.getElementById("mag-z");
    if (compassNeedle) compassNeedle.style.transform = "rotate(" + heading + "deg)";
    if (deg) deg.textContent = Math.round(heading);
    if (dir) dir.textContent = dirs[Math.round(heading/45)%8];
    if (mx)  mx.textContent  = (Math.random()>0.5?"+":"-") + Math.floor(Math.random()*120) + " µT";
    if (my)  my.textContent  = (Math.random()>0.5?"+":"-") + Math.floor(Math.random()*120) + " µT";
    if (mz)  mz.textContent  = (Math.random()>0.5?"+":"-") + Math.floor(Math.random()*35)  + " µT";
  }, 1200);

  // ── MQ135 Gas ──
  let ppm = 382;
  const gasData = Array(30).fill(ppm);
  function gasLabel(v){ return v<300?"CLEAN":v<600?"GOOD":v<800?"MODERATE":"HAZARDOUS"; }
  function gasColor(v){ return v<300?"#10B981":v<600?"#84cc16":v<800?"#F59E0B":"#f43f5e"; }
  setInterval(() => {
    ppm = Math.max(50, Math.min(1000, ppm + (Math.random()*30-15)));
    gasData.shift(); gasData.push(ppm);
    const readout  = document.getElementById("gas-readout");
    const badge    = document.getElementById("gas-badge");
    const valBadge = document.getElementById("gas-val-badge");
    const marker   = document.getElementById("gas-marker");
    if (readout)  readout.textContent  = Math.round(ppm);
    const col = gasColor(ppm);
    const lbl = gasLabel(ppm);
    if (badge)    { badge.textContent    = lbl;    badge.style.color    = col; }
    if (valBadge) { valBadge.textContent = lbl[0] + lbl.slice(1).toLowerCase(); valBadge.style.color = col; }
    if (marker)   marker.style.left = (ppm/10)+"%";
    renderChart("gas-chart", "gas-line", "gas-area", gasData, 0, 1000);
  }, 1500);

  // ── BMP Temperature ──
  let temp = 24.7;
  const tempData = Array(30).fill(temp);
  setInterval(() => {
    temp = Math.max(-20, Math.min(85, temp + (Math.random()*1.4-0.7)));
    tempData.shift(); tempData.push(temp);
    const valEl  = document.getElementById("temp-val");
    const marker = document.getElementById("temp-marker");
    if (valEl)  valEl.textContent  = temp.toFixed(1);
    if (marker) marker.style.left  = (((temp+20)/105)*100)+"%";
    renderChart("temp-chart", "temp-line", "temp-area", tempData, -20, 85);
  }, 1800);

  // ── BMP Pressure ──
  let pressure = 1013;
  const presData = Array(30).fill(pressure);
  setInterval(() => {
    pressure = Math.max(900, Math.min(1050, pressure + (Math.random()*2-1)));
    presData.shift(); presData.push(pressure);
    const valEl  = document.getElementById("pres-val");
    const altEl  = document.getElementById("pres-alt");
    const marker = document.getElementById("pres-marker");
    if (valEl)  valEl.textContent  = Math.round(pressure);
    if (altEl)  altEl.textContent  = "~" + Math.round(44330*(1-Math.pow(pressure/1013.25,0.1903))) + "m";
    if (marker) marker.style.left  = Math.max(1,Math.min(99,((pressure-900)/150)*100))+"%";
    renderChart("pres-chart", "pres-line", "pres-area", presData, 900, 1050);
  }, 2000);

  // ── Battery ──
  let batt = 78;
  setInterval(() => {
    batt = Math.max(0, Math.min(100, batt - 0.08));
    const fill = document.getElementById("batt-fill-header");
    const pct  = document.getElementById("batt-pct-header");
    const pill = document.getElementById("battery-header-pill");
    if (fill) fill.setAttribute("width", Math.max(1, Math.round((batt/100)*20)));
    if (pct)  pct.textContent = Math.round(batt);
    const color = batt<20?"#f43f5e":batt<40?"#F59E0B":"#10B981";
    if (fill) fill.setAttribute("fill", color);
    if (pct)  pct.style.color = color;
    if (pill) pill.className = batt<20?"battery-pill critical":batt<40?"battery-pill warning":"battery-pill";
  }, 2000);

  // Initial chart render after layout settles
  setTimeout(() => {
    renderChart("gas-chart",  "gas-line",  "gas-area",  gasData,  0,    1000);
    renderChart("temp-chart", "temp-line", "temp-area", tempData, -20,  85);
    renderChart("pres-chart", "pres-line", "pres-area", presData, 900,  1050);
  }, 300);

});
</script>
