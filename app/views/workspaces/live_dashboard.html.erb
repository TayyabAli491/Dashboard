<%# CanSat Live Dashboard — clean orchestration view.
    Widgets live in: app/views/workspaces/widgets/_*.html.erb %>

<% content_for :head do %>
  <%= stylesheet_link_tag "static_theme", "data-turbo-track": "reload" %>
<% end %>
<div class="fixed inset-0 z-[100] bg-[#050810] cansat-dashboard overflow-hidden flex flex-col"
     style="background-image: radial-gradient(rgba(99,102,241,0.10) 1.5px, transparent 1.5px); background-size:32px 32px;"
     data-controller="dashboard live-telemetry"
     data-dashboard-workspace-id-value="<%= @workspace.id %>"
     data-dashboard-edit-mode-value="false">

  <%# Background video (optional) %>
  <% if @workspace.dashboard_theme == 'video' && @workspace.background_video.attached? %>
    <video src="<%= url_for(@workspace.background_video) %>"
           class="fixed inset-0 w-full h-full object-cover z-0 pointer-events-none"
           autoplay loop muted playsinline>
    </video>
  <% end %>

  <%# ——— HEADER ——— %>
  <%= render "workspaces/widgets/dashboard_header", workspace: @workspace, active_session: @active_session %>

  <%# ——— MAIN LAYOUT ——— %>
  <div class="pt-16 px-5 pb-5 h-full w-full relative z-10 flex flex-col gap-4">

    <%# TOP ROW: CanSat 3D (left) | empty center | GPS (right) %>
    <div class="flex gap-4 flex-1 min-h-0">

      <%= render "workspaces/widgets/attitude_widget", workspace_id: @workspace.id %>

      <div class="flex-1 min-w-0" style="display:flex; flex-direction:column;">
        <%= render "workspaces/widgets/camera_widget", workspace_id: @workspace.id %>
      </div>

      <%= render "workspaces/widgets/gps_widget", workspace_id: @workspace.id %>

    </div><!-- /top row -->

    <%# BOTTOM ROW: 4 sensor cards, equal-width grid %>
    <div class="bottom-scroller" style="flex-shrink:0; height:230px;">
      <%= render "workspaces/widgets/magnetometer_widget" %>
      <%= render "workspaces/widgets/gas_widget",         workspace_id: @workspace.id %>
      <%= render "workspaces/widgets/temperature_widget" %>
      <%= render "workspaces/widgets/pressure_widget" %>
    </div>

  </div><!-- /main layout -->
</div>
