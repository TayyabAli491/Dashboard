<%= turbo_frame_tag "remote_modal" do %>
  <div class="fixed inset-0 z-50 flex items-center justify-center p-4" style="background-color: rgba(26, 26, 26, 0.4); backdrop-filter: blur(2px);">
    <div class="card relative overflow-hidden" style="width: 100%; max-width: 650px; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);">
      <div class="card-accent amber" style="height: 6px;"></div>
      
      <button onclick="this.closest('turbo-frame').innerHTML=''" class="absolute right-4 top-4 w-8 h-8 flex items-center border border-[#E8E4DD] justify-center rounded-lg bg-[#F7F5F1] text-[#6B6560] hover:bg-white hover:text-[#1A1A1A] hover:border-[#C8C3BB] transition-colors cursor-pointer" title="Close">
        <i class="fa-solid fa-xmark"></i>
      </button>

      <div class="card-title pr-8">Edit Workspace</div>
      <div class="card-desc mb-2">Update your workspace details and settings.</div>
      
      <%= render "form", workspace: @workspace %>
    </div>
  </div>
<% end %>
