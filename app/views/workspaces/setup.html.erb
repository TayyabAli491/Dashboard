<div class="flex flex-col gap-8 max-w-2xl mx-auto">

  <div>
    <h1 class="page-title">Setup</h1>
    <p class="page-subtitle">
      <%= @workspace.name %>
    </p>
  </div>

  <%# Tab navigation %>
  <div class="flex gap-2 border-b border-border pb-0">
    <a href="#connection"
       class="px-4 py-2 text-base font-medium
              text-text-primary border-b-2
              border-primary -mb-px">
      Connection
    </a>
    <a href="#schema"
       class="px-4 py-2 text-base font-medium
              text-text-muted hover:text-text-primary">
      Payload Schema
    </a>
  </div>

  <%# Connection section %>
  <div id="connection" class="card flex flex-col gap-6">

    <div>
      <p class="section-label mb-2">Endpoint URL</p>
      <div class="flex items-center gap-3 p-3
                  bg-glass-subtle rounded-lg
                  border border-border">
        <code class="mono flex-1">
          <%= request.base_url %>/api/workspaces/<%= @workspace.id %>/telemetry
        </code>
        <button class="btn-ghost text-sm"
                data-controller="clipboard"
                data-clipboard-text-value="<%= request.base_url %>/api/workspaces/<%= @workspace.id %>/telemetry">
          Copy
        </button>
      </div>
    </div>

    <div>
      <p class="section-label mb-2">API Key</p>
      <div class="flex items-center gap-3 p-3
                  bg-glass-subtle rounded-lg
                  border border-border">
        <code class="mono flex-1">••••••••••••••••</code>
        <button class="btn-ghost text-sm">Reveal</button>
        <button class="btn-ghost text-sm">Copy</button>
        <button class="btn-danger text-sm">Regenerate</button>
      </div>
      <p class="input-error mt-2">
        Regenerating invalidates your current key immediately
      </p>
    </div>

  </div>

  <%# Schema section %>
  <div id="schema" class="card flex flex-col gap-4">
    <div class="flex items-center justify-between">
      <p class="section-label">Payload Schema</p>
      <%= link_to "Edit Schema",
            edit_workspace_payload_schema_path(@workspace),
            class: "btn-ghost text-sm" %>
    </div>
    <% if @workspace.payload_schema_defined? %>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left border-b border-border">
            <th class="pb-2 text-text-muted font-medium">Key</th>
            <th class="pb-2 text-text-muted font-medium">Type</th>
            <th class="pb-2 text-text-muted font-medium">Unit</th>
            <th class="pb-2 text-text-muted font-medium">Alias</th>
          </tr>
        </thead>
        <tbody>
          <% @workspace.payload_schema.fields.each do |field| %>
            <tr class="border-b border-border-subtle">
              <td class="py-3 mono"><%= field["key"] %></td>
              <td class="py-3 text-text-secondary">
                <%= field["type"] %>
              </td>
              <td class="py-3 text-text-secondary">
                <%= field["unit"] %>
              </td>
              <td class="py-3 text-text-secondary">
                <%= field["alias"] %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text-text-muted text-sm">
        No schema defined yet.
      </p>
    <% end %>
  </div>

</div>
