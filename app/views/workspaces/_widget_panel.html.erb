<div class="flex flex-col h-full">

  <%# Panel header %>
  <div class="flex items-center justify-between 
              p-4 border-b border-border">
    <h2 class="text-text-primary font-semibold text-md">
      Add Widget
    </h2>
    <button class="btn-ghost text-sm"
            data-action="click->dashboard#closeWidgetPanel">
      ✕ Close
    </button>
  </div>

  <%# Widget type grid %>
  <div class="flex-1 overflow-y-auto p-4"
       data-controller="widget-form"
       data-widget-form-workspace-id-value="<%= @workspace.id %>">
    <p class="section-label mb-4">Choose widget type</p>

    <div class="grid grid-cols-2 gap-3 mb-6">

      <% widget_types = [
        { type: "ValueCard",  icon: "⬡",
          label: "Value Card",
          desc: "Single live value" },
        { type: "LineChart",  icon: "📈",
          label: "Line Chart",
          desc: "Time-series data" },
        { type: "GaugeChart", icon: "⊙",
          label: "Gauge",
          desc: "Circular meter" },
        { type: "BarChart",   icon: "▦",
          label: "Bar Chart",
          desc: "Compare fields" },
        { type: "GPSMap",     icon: "◉",
          label: "GPS Map",
          desc: "Live position" },
        { type: "Attitude3D", icon: "⟳",
          label: "3D Attitude",
          desc: "Pitch roll yaw" },
        { type: "Compass3D",  icon: "⊕",
          label: "3D Compass",
          desc: "Heading direction" },
        { type: "AltitudeBar",icon: "↑",
          label: "Altitude Bar",
          desc: "Visual altitude" }
      ] %>

      <% widget_types.each do |wt| %>
        <button class="card-subtle flex flex-col 
                       items-start gap-1 p-3 text-left
                       hover:border-primary 
                       transition-all duration-150
                       cursor-pointer"
                data-action="click->widget-form#selectType"
                data-widget-form-type-param="<%= wt[:type] %>">
          <span class="text-xl"><%= wt[:icon] %></span>
          <span class="text-text-primary text-sm 
                       font-medium">
            <%= wt[:label] %>
          </span>
          <span class="text-text-muted text-xs">
            <%= wt[:desc] %>
          </span>
        </button>
      <% end %>

    </div>

    <%# Widget config form — shown after type selected %>
    <div class="hidden flex-col gap-4"
         id="widget-config-form">

      <div class="divider"></div>
      <p class="section-label">Configure widget</p>

      <input type="hidden" 
             id="selected-widget-type"
             data-widget-form-target="typeInput">

      <div>
        <label class="input-label">Label</label>
        <input type="text"
               class="input"
               placeholder="e.g. Air Quality"
               data-widget-form-target="labelInput">
      </div>

      <div id="field-selectors"
           data-widget-form-target="fieldSelectors">
        <label class="input-label">Field</label>
        <select class="input"
                data-widget-form-target="fieldSelect">
          <% @workspace.payload_schema&.fields&.each do |f| %>
            <option value="<%= f['key'] %>">
              <%= f['alias'].presence || f['key'] %> 
              (<%= f['unit'] %>)
            </option>
          <% end %>
        </select>
      </div>

      <div>
        <label class="input-label">Color</label>
        <div class="flex items-center gap-3">
          <% colors = %w[primary cyan success warning danger] %>
          <% color_classes = {
            "primary" => "bg-primary",
            "cyan" => "bg-cyan-500",
            "success" => "bg-green-500",
            "warning" => "bg-amber-500",
            "danger" => "bg-red-500"
          } %>
          <% colors.each do |color| %>
            <button class="w-6 h-6 rounded-full 
                           border-2 border-transparent
                           hover:border-white
                           transition-all duration-150
                           <%= color_classes[color] %>"
                    data-action="click->widget-form#selectColor"
                    data-widget-form-color-param="<%= color %>">
            </button>
          <% end %>
        </div>
      </div>

      <button class="btn-primary w-full justify-center"
              data-action="click->widget-form#addWidget">
        Add to Dashboard
      </button>

    </div>
  </div>
</div>
