<%# MQ135 Air Quality / Gas Sensor Widget %>
<div class="sensor-card" style="--accent: rgba(6,182,212,0.6);">
  <div class="sc-header">
    <div class="sc-header-left">
      <div class="sc-icon" style="background:rgba(6,182,212,0.12);color:#06B6D4;">💨</div>
      <div>
        <div class="sc-title">MQ135</div>
        <div class="sc-subtitle">Air Quality &middot; CO₂ equivalent</div>
      </div>
    </div>
    <span class="sc-badge" style="color:#10B981;" id="gas-badge">GOOD</span>
  </div>

  <div class="sc-value-row">
    <div class="sc-big" style="color:#E5E5E5;"><span id="gas-readout">382</span></div>
    <span class="sc-unit">ppm</span>
    <span class="sc-val-badge" style="color:#10B981;" id="gas-val-badge">Good</span>
  </div>

  <div class="sc-scale-wrap">
    <div class="sc-scale-bar">
      <div class="sc-scale-marker" id="gas-marker" style="left:38%;"></div>
    </div>
    <div class="sc-scale-labels">
      <span>0</span><span>250</span><span>500</span><span>750</span><span>1000</span>
    </div>
  </div>

  <div class="sc-chart-wrap">
    <div class="sc-chart-labels">
      <span>800 ppm</span>
      <span style="margin-top:auto;">300 ppm</span>
    </div>
    <div class="sc-line-chart">
      <svg id="gas-chart" preserveAspectRatio="none">
        <defs>
          <linearGradient id="gasGrad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%"   stop-color="#10B981" stop-opacity="0.25"/>
            <stop offset="100%" stop-color="#10B981" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <path id="gas-area" fill="url(#gasGrad)"/>
        <path id="gas-line" fill="none" stroke="#10B981" stroke-width="1.5" stroke-linejoin="round"/>
      </svg>
    </div>
    <div class="sc-chart-time">seconds</div>
  </div>

  <%# Hidden canvas keeps gauge-chart controller happy for live telemetry updates %>
  <canvas class="hidden"
          data-controller="gauge-chart"
          data-gauge-chart-workspace-id-value="<%= workspace_id %>"
          data-gauge-chart-field-value="mq135"
          data-gauge-chart-min-value="0"
          data-gauge-chart-max-value="1000"
          data-gauge-chart-color-value="cyan">
  </canvas>
</div>
