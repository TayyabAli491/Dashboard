<%# QMC5883L Magnetometer Widget %>
<div class="sensor-card" style="--accent: rgba(139,92,246,0.6);">
  <div class="sc-header">
    <div class="sc-header-left">
      <div class="sc-icon" style="background:rgba(139,92,246,0.12);color:#8b5cf6;">🧭</div>
      <div>
        <div class="sc-title">QMC5883L</div>
        <div class="sc-subtitle">Magnetometer &middot; Heading</div>
      </div>
    </div>
    <span class="sc-badge" style="color:#8b5cf6;" id="mag-badge">ACTIVE</span>
  </div>

  <div class="sc-value-row">
    <div class="sc-big" style="color:#E5E5E5;"><span id="compass-deg">137</span></div>
    <span class="sc-unit">°</span>
    <span class="sc-val-badge" style="color:#8b5cf6;" id="compass-dir">SE</span>
  </div>

  <div style="display:flex; align-items:center; gap:12px; padding:4px 14px 8px; flex:1;">
    <svg width="88" height="88" viewBox="0 0 100 100" fill="none">
      <circle cx="50" cy="50" r="46" stroke="rgba(139,92,246,0.15)" stroke-width="1"/>
      <circle cx="50" cy="50" r="38" stroke="rgba(139,92,246,0.08)" stroke-width="7" fill="none"/>
      <line x1="50" y1="4"  x2="50" y2="12" stroke="rgba(139,92,246,0.7)" stroke-width="2"/>
      <line x1="96" y1="50" x2="88" y2="50" stroke="rgba(255,255,255,0.1)" stroke-width="1.5"/>
      <line x1="50" y1="96" x2="50" y2="88" stroke="rgba(255,255,255,0.1)" stroke-width="1.5"/>
      <line x1="4"  y1="50" x2="12" y2="50" stroke="rgba(255,255,255,0.1)" stroke-width="1.5"/>
      <text x="50" y="19" text-anchor="middle" fill="rgba(139,92,246,0.85)" font-size="7" font-family="monospace" font-weight="bold">N</text>
      <text x="92" y="53" text-anchor="middle" fill="rgba(255,255,255,0.2)" font-size="6" font-family="monospace">E</text>
      <text x="50" y="93" text-anchor="middle" fill="rgba(255,255,255,0.2)" font-size="6" font-family="monospace">S</text>
      <text x="8"  y="53" text-anchor="middle" fill="rgba(255,255,255,0.2)" font-size="6" font-family="monospace">W</text>
      <g id="compass-needle" class="compass-needle" style="transform-origin:50px 50px; transform:rotate(137deg);">
        <polygon points="50,14 47,52 53,52" fill="rgba(139,92,246,0.95)"/>
        <polygon points="50,86 47,52 53,52" fill="rgba(255,255,255,0.12)"/>
      </g>
      <circle cx="50" cy="50" r="4" fill="#8b5cf6"/>
      <circle cx="50" cy="50" r="2" fill="#111318"/>
    </svg>

    <div class="sc-stats" style="flex:1; padding:0; margin:0;">
      <div class="sc-stat"><div class="sc-stat-l">X-axis</div><div class="sc-stat-v" id="mag-x">-42 µT</div></div>
      <div class="sc-stat"><div class="sc-stat-l">Y-axis</div><div class="sc-stat-v" id="mag-y">+89 µT</div></div>
      <div class="sc-stat"><div class="sc-stat-l">Z-axis</div><div class="sc-stat-v" id="mag-z">-12 µT</div></div>
      <div class="sc-stat"><div class="sc-stat-l">Declination</div><div class="sc-stat-v">+3.2°</div></div>
    </div>
  </div>
</div>
