<%= turbo_stream_from "workspace_#{@workspace.id}_status" %>

<div class="flex flex-col items-center justify-center 
            min-h-[60vh] gap-8"
     data-controller="auto-refresh"
     data-auto-refresh-url-value="<%= workspace_path(@workspace) %>"
     data-auto-refresh-interval-value="3000">

  <div class="text-center">
    <div class="flex items-center justify-center gap-2 mb-3">
      <span class="status-dot status-dot-warning"></span>
      <span class="text-text-muted text-sm">
        Waiting for first data packet
      </span>
    </div>
    <h1 class="page-title"><%= @workspace.name %></h1>
    <p class="page-subtitle mt-2">
      Schema defined. Connect your device to continue.
    </p>
  </div>

  <div class="card w-full max-w-lg flex flex-col gap-6">

    <div>
      <p class="section-label mb-3">POST endpoint</p>
      <div class="flex items-center gap-3 p-3 
                  bg-glass-subtle rounded-lg 
                  border border-border">
        <code class="mono flex-1">
          <%= request.base_url %>/api/workspaces/<%= @workspace.id %>/telemetry
        </code>
        <button class="btn-ghost text-sm"
                data-controller="clipboard"
                data-clipboard-text-value="<%= request.base_url %>/api/workspaces/<%= @workspace.id %>/telemetry">
          Copy
        </button>
      </div>
    </div>

    <div>
      <p class="section-label mb-3">API key</p>
      <div class="flex items-center gap-3 p-3 
                  bg-glass-subtle rounded-lg 
                  border border-border">
        <code class="mono flex-1" 
              data-reveal-target="value"
              data-value="<%= @workspace.api_key %>">
          ••••••••••••••••
        </code>
        <button class="btn-ghost text-sm"
                data-controller="reveal"
                data-reveal-target="toggle">
          Reveal
        </button>
        <button class="btn-ghost text-sm"
                data-controller="clipboard"
                data-clipboard-text-value="<%= @workspace.api_key %>">
          Copy
        </button>
      </div>
    </div>

    <div>
      <p class="section-label mb-3">Expected payload</p>
      <pre class="mono p-3 bg-glass-subtle rounded-lg 
                  border border-border text-text-secondary 
                  overflow-x-auto"><%= example_payload_json(@workspace.payload_schema) %></pre>
    </div>

    <div class="flex items-center gap-3">
      <span class="status-dot status-dot-warning"></span>
      <span class="text-text-muted text-sm">
        This page refreshes automatically 
        when data arrives
      </span>
    </div>

  </div>
</div>
