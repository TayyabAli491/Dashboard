<div class="auth-layout">
  <section class="auth-art-panel">
    <div class="auth-art-backdrop"></div>

    <!-- Network Topology Scene -->
    <div class="topo-scene">
      <!-- Central hub -->
      <div class="topo-hub">
        <div class="topo-hub-core"></div>
        <div class="topo-hub-pulse"></div>
        <div class="topo-hub-pulse topo-hub-pulse-2"></div>
      </div>

      <!-- Branch lines radiating from hub -->
      <svg class="topo-svg" viewBox="0 0 600 700" preserveAspectRatio="xMidYMid slice">
        <!-- Main branches from hub center (300, 380) -->
        <path class="topo-branch" d="M300,380 C280,320 240,280 190,230" />
        <path class="topo-branch" d="M300,380 C320,310 360,270 400,220" />
        <path class="topo-branch" d="M300,380 C250,360 200,350 140,340" />
        <path class="topo-branch" d="M300,380 C350,360 400,355 460,350" />
        <path class="topo-branch" d="M300,380 C280,420 250,460 200,510" />
        <path class="topo-branch" d="M300,380 C330,430 360,470 410,520" />
        <path class="topo-branch" d="M300,380 C270,350 220,310 160,270" />
        <path class="topo-branch" d="M300,380 C340,340 390,300 450,260" />

        <!-- Sub-branches -->
        <path class="topo-branch-sub" d="M190,230 C170,200 140,170 110,140" />
        <path class="topo-branch-sub" d="M190,230 C220,210 240,180 260,150" />
        <path class="topo-branch-sub" d="M400,220 C420,190 450,160 480,130" />
        <path class="topo-branch-sub" d="M400,220 C380,195 370,165 350,140" />
        <path class="topo-branch-sub" d="M140,340 C110,330 80,310 50,290" />
        <path class="topo-branch-sub" d="M140,340 C120,370 100,400 70,430" />
        <path class="topo-branch-sub" d="M460,350 C490,340 520,320 550,300" />
        <path class="topo-branch-sub" d="M460,350 C480,380 500,410 530,440" />
        <path class="topo-branch-sub" d="M200,510 C170,540 150,570 120,600" />
        <path class="topo-branch-sub" d="M200,510 C230,540 250,570 260,610" />
        <path class="topo-branch-sub" d="M410,520 C440,550 460,580 490,610" />
        <path class="topo-branch-sub" d="M410,520 C390,550 370,585 350,620" />
        <path class="topo-branch-sub" d="M160,270 C130,250 100,230 70,200" />
        <path class="topo-branch-sub" d="M450,260 C480,240 510,220 540,190" />

        <!-- Data flow particles (circles that travel along paths) -->
        <circle class="data-particle dp-1" r="3">
          <animateMotion dur="3s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1">
            <mpath href="#flow1" />
          </animateMotion>
        </circle>
        <circle class="data-particle dp-2" r="2.5">
          <animateMotion dur="3.5s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1">
            <mpath href="#flow2" />
          </animateMotion>
        </circle>
        <circle class="data-particle dp-3" r="2">
          <animateMotion dur="2.8s" repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1">
            <mpath href="#flow3" />
          </animateMotion>
        </circle>
        <circle class="data-particle dp-4" r="3">
          <animateMotion dur="4s" repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1">
            <mpath href="#flow4" />
          </animateMotion>
        </circle>
        <circle class="data-particle dp-5" r="2">
          <animateMotion dur="3.2s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1">
            <mpath href="#flow5" />
          </animateMotion>
        </circle>
        <circle class="data-particle dp-6" r="2.5">
          <animateMotion dur="3.8s" repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1">
            <mpath href="#flow6" />
          </animateMotion>
        </circle>
        <circle class="data-particle dp-7" r="2">
          <animateMotion dur="2.5s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1">
            <mpath href="#flow7" />
          </animateMotion>
        </circle>
        <circle class="data-particle dp-8" r="3">
          <animateMotion dur="4.2s" repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1">
            <mpath href="#flow8" />
          </animateMotion>
        </circle>
        <circle class="data-particle dp-9" r="2">
          <animateMotion dur="3s" repeatCount="indefinite" keyPoints="0;1" keyTimes="0;1">
            <mpath href="#flow9" />
          </animateMotion>
        </circle>
        <circle class="data-particle dp-10" r="2.5">
          <animateMotion dur="3.6s" repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1">
            <mpath href="#flow10" />
          </animateMotion>
        </circle>

        <!-- Hidden motion paths -->
        <path id="flow1"  d="M300,380 C280,320 240,280 190,230 C170,200 140,170 110,140" fill="none" />
        <path id="flow2"  d="M300,380 C320,310 360,270 400,220 C420,190 450,160 480,130" fill="none" />
        <path id="flow3"  d="M300,380 C250,360 200,350 140,340 C110,330 80,310 50,290" fill="none" />
        <path id="flow4"  d="M300,380 C350,360 400,355 460,350 C490,340 520,320 550,300" fill="none" />
        <path id="flow5"  d="M300,380 C280,420 250,460 200,510 C170,540 150,570 120,600" fill="none" />
        <path id="flow6"  d="M300,380 C330,430 360,470 410,520 C440,550 460,580 490,610" fill="none" />
        <path id="flow7"  d="M300,380 C270,350 220,310 160,270 C130,250 100,230 70,200" fill="none" />
        <path id="flow8"  d="M300,380 C340,340 390,300 450,260 C480,240 510,220 540,190" fill="none" />
        <path id="flow9"  d="M300,380 C280,420 250,460 200,510 C230,540 250,570 260,610" fill="none" />
        <path id="flow10" d="M300,380 C320,310 360,270 400,220 C380,195 370,165 350,140" fill="none" />

        <!-- Endpoint nodes -->
        <circle class="topo-node topo-node-lg" cx="300" cy="380" r="12" />
        <circle class="topo-node" cx="190" cy="230" r="6" />
        <circle class="topo-node" cx="400" cy="220" r="7" />
        <circle class="topo-node" cx="140" cy="340" r="5" />
        <circle class="topo-node" cx="460" cy="350" r="6" />
        <circle class="topo-node" cx="200" cy="510" r="5" />
        <circle class="topo-node" cx="410" cy="520" r="6" />
        <circle class="topo-node" cx="160" cy="270" r="5" />
        <circle class="topo-node" cx="450" cy="260" r="5" />

        <!-- Leaf nodes -->
        <circle class="topo-leaf" cx="110" cy="140" r="4" />
        <circle class="topo-leaf" cx="260" cy="150" r="3" />
        <circle class="topo-leaf" cx="480" cy="130" r="4" />
        <circle class="topo-leaf" cx="350" cy="140" r="3" />
        <circle class="topo-leaf" cx="50"  cy="290" r="3" />
        <circle class="topo-leaf" cx="70"  cy="430" r="4" />
        <circle class="topo-leaf" cx="550" cy="300" r="3" />
        <circle class="topo-leaf" cx="530" cy="440" r="4" />
        <circle class="topo-leaf" cx="120" cy="600" r="3" />
        <circle class="topo-leaf" cx="260" cy="610" r="4" />
        <circle class="topo-leaf" cx="490" cy="610" r="3" />
        <circle class="topo-leaf" cx="350" cy="620" r="3" />
        <circle class="topo-leaf" cx="70"  cy="200" r="3" />
        <circle class="topo-leaf" cx="540" cy="190" r="4" />
      </svg>
    </div>

    <div class="relative z-10">
      <div class="inline-flex items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3.5 py-2">
        <div class="w-8 h-8 rounded-lg bg-[#F7F5F1] text-[#1A1A1A] flex items-center justify-center">
          <i class="fa-solid fa-satellite-dish"></i>
        </div>
        <div>
          <div class="text-[13px] font-semibold tracking-tight text-[#F7F5F1] leading-none">ArckOne</div>
          <div class="text-[10px] text-[#B5B0A8] tracking-[0.12em] mt-1">MULTI-TENANT IOT DASHBOARD</div>
        </div>
      </div>

      <h1 class="text-[26px] sm:text-[34px] font-semibold tracking-tight mt-7 leading-[1.1] max-w-xl">
        Observe every workspace in one real-time engineering command center.
      </h1>
      <p class="text-[13px] sm:text-[14px] text-[#D6D1CB] max-w-xl mt-4 leading-relaxed">
        Stream telemetry from distributed devices, apply custom schemas, and monitor project dashboards with live infrastructure visibility.
      </p>

      <div class="flex flex-wrap gap-2 mt-6">
        <span class="auth-pill">
          <span class="auth-pill-dot" style="background:#D6D1CB"></span>
          Live telemetry
        </span>
        <span class="auth-pill">
          <span class="auth-pill-dot" style="background:#B5B0A8"></span>
          Scalable tenancy
        </span>
        <span class="auth-pill">
          <span class="auth-pill-dot" style="background:#E8E4DD"></span>
          Real-time streams
        </span>
      </div>
    </div>

    <!-- Bottom metric bar -->
    <div class="auth-metric-bar relative z-10">
      <div class="auth-metric">
        <div class="auth-metric-label">Hub Devices</div>
        <div class="auth-metric-value">367</div>
      </div>
      <div class="auth-metric-divider"></div>
      <div class="auth-metric">
        <div class="auth-metric-label">Metrics</div>
        <div class="auth-metric-value">3.7k</div>
      </div>
      <div class="auth-metric-divider"></div>
      <div class="auth-metric">
        <div class="auth-metric-label">Sensors</div>
        <div class="auth-metric-value">735</div>
      </div>
      <div class="auth-metric-divider"></div>
      <div class="auth-metric">
        <div class="auth-metric-label">Uptime</div>
        <div class="auth-metric-value">99.9%</div>
      </div>
    </div>
  </section>

  <section class="auth-form-panel">
    <div class="auth-form-container">
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-[10px] bg-[#1A1A1A] text-white flex items-center justify-center">
          <i class="fa-solid fa-satellite-dish"></i>
        </div>
        <div>
          <div class="text-[14px] font-semibold text-[#1A1A1A] tracking-tight leading-none">ArckOne</div>
          <div class="text-[10px] text-[#9E9891] tracking-[0.14em] mt-1">IOT PLATFORM</div>
        </div>
      </div>

      <div class="auth-form-card">
        <div class="mb-7">
          <div class="page-eyebrow text-center">Welcome back</div>
          <h2 class="text-center text-[30px] font-semibold tracking-tight text-[#1A1A1A]">Log in</h2>
        </div>

        <%= render "devise/shared/error_messages", resource: resource %>

        <%= form_for(resource, as: resource_name, url: user_session_path, html: { class: "space-y-5" }) do |f| %>
          <div>
            <%= f.label :email, class: "card-meta-label block mb-1.5" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "auth-input" %>
          </div>

          <div>
            <%= f.label :password, class: "card-meta-label block mb-1.5" %>
            <%= f.password_field :password, autocomplete: "current-password", class: "auth-input" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="flex items-center gap-2.5 py-1">
              <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-[#E8E4DD] text-[#1A1A1A] focus:ring-[#1A1A1A] cursor-pointer" %>
              <%= f.label :remember_me, class: "text-[13px] font-medium text-[#6B6560] cursor-pointer" %>
            </div>
          <% end %>

          <div class="pt-1">
            <%= f.submit "Log in", class: "btn-new w-full justify-center cursor-pointer border-0 !mt-0 !py-2.5 !text-[13px]" %>
          </div>
        <% end %>

        <div class="mt-6 pt-5 border-t border-[#E8E4DD]">
          <%= render "devise/shared/links" %>
        </div>
      </div>

      <div>
        <p class="text-center text-[11px] text-[#9E9891] mt-5">Secure access to your telemetry and workspace infrastructure.</p>
      </div>
    </div>
  </section>
</div>
