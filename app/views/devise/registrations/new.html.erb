<div class="min-h-screen bg-[#F7F5F1] flex items-center justify-center py-12 px-4">
  <div class="w-full max-w-md">
    <div class="flex items-center justify-center gap-3 mb-6">
      <div class="w-10 h-10 rounded-[10px] bg-[#1A1A1A] text-white flex items-center justify-center">
        <i class="fa-solid fa-satellite-dish"></i>
      </div>
      <div>
        <div class="text-[14px] font-semibold text-[#1A1A1A] tracking-tight leading-none">OrbStack</div>
        <div class="text-[10px] text-[#9E9891] tracking-[0.14em] mt-1">IOT PLATFORM</div>
      </div>
    </div>

    <div class="bg-white border border-[#E8E4DD] rounded-xl shadow-sm p-8">
      <div class="mb-7">
        <div class="page-eyebrow text-center">Get started</div>
        <h2 class="text-center text-[30px] font-semibold tracking-tight text-[#1A1A1A]">Create your account</h2>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div>
          <%= f.label :email, class: "card-meta-label block mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full bg-[#F7F5F1] border border-[#E8E4DD] rounded-lg px-3 py-2.5 text-[14px] text-[#1A1A1A] placeholder-[#9E9891] focus:outline-none focus:border-[#C8C3BB] focus:bg-white transition-all shadow-sm" %>
        </div>

        <div>
          <%= f.label :password, class: "card-meta-label block mb-1.5" %>
          <% if @minimum_password_length %>
            <p class="text-[11px] text-[#9E9891] mb-1.5">Minimum <%= @minimum_password_length %> characters</p>
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", class: "w-full bg-[#F7F5F1] border border-[#E8E4DD] rounded-lg px-3 py-2.5 text-[14px] text-[#1A1A1A] placeholder-[#9E9891] focus:outline-none focus:border-[#C8C3BB] focus:bg-white transition-all shadow-sm" %>
        </div>

        <div>
          <%= f.label :password_confirmation, class: "card-meta-label block mb-1.5" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full bg-[#F7F5F1] border border-[#E8E4DD] rounded-lg px-3 py-2.5 text-[14px] text-[#1A1A1A] placeholder-[#9E9891] focus:outline-none focus:border-[#C8C3BB] focus:bg-white transition-all shadow-sm" %>
        </div>

        <div class="pt-1">
          <%= f.submit "Sign up", class: "btn-new w-full justify-center cursor-pointer border-0 !mt-0 !py-2.5 !text-[13px]" %>
        </div>
      <% end %>

      <div class="mt-6 pt-5 border-t border-[#E8E4DD]">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
