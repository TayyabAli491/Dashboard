<div class="auth-layout">
  <section class="auth-art-panel">
    <div class="auth-art-backdrop"></div>

    <!-- tsParticles container -->
    <div id="signup-particles" class="absolute inset-0 z-[1]"></div>

    <div class="relative z-10">
      <div class="inline-flex items-center gap-3 rounded-xl border border-white/15 bg-white/5 px-3.5 py-2">
        <div class="w-8 h-8 rounded-lg bg-[#F7F5F1] text-[#1A1A1A] flex items-center justify-center">
          <i class="fa-solid fa-satellite-dish"></i>
        </div>
        <div>
          <div class="text-[13px] font-semibold tracking-tight text-[#F7F5F1] leading-none">ArckOne</div>
          <div class="text-[10px] text-[#B5B0A8] tracking-[0.12em] mt-1">MULTI-TENANT IOT DASHBOARD</div>
        </div>
      </div>

      <h1 class="text-[26px] sm:text-[34px] font-semibold tracking-tight mt-7 leading-[1.1] max-w-xl">
        Build your command center for real-time telemetry.
      </h1>
      <p class="text-[13px] sm:text-[14px] text-[#D6D1CB] max-w-xl mt-4 leading-relaxed">
        Create your workspace, connect your IoT devices, and start monitoring data streams in minutes.
      </p>

      <div class="flex flex-wrap gap-2 mt-6">
        <span class="auth-pill">
          <span class="auth-pill-dot" style="background:#D6D1CB"></span>
          Free to start
        </span>
        <span class="auth-pill">
          <span class="auth-pill-dot" style="background:#B5B0A8"></span>
          No credit card
        </span>
        <span class="auth-pill">
          <span class="auth-pill-dot" style="background:#E8E4DD"></span>
          Instant setup
        </span>
      </div>
    </div>

    <!-- Bottom metric bar -->
    <div class="auth-metric-bar relative z-10">
      <div class="auth-metric">
        <div class="auth-metric-label">Teams</div>
        <div class="auth-metric-value">1.2k</div>
      </div>
      <div class="auth-metric-divider"></div>
      <div class="auth-metric">
        <div class="auth-metric-label">Projects</div>
        <div class="auth-metric-value">8.4k</div>
      </div>
      <div class="auth-metric-divider"></div>
      <div class="auth-metric">
        <div class="auth-metric-label">Countries</div>
        <div class="auth-metric-value">47</div>
      </div>
      <div class="auth-metric-divider"></div>
      <div class="auth-metric">
        <div class="auth-metric-label">Uptime</div>
        <div class="auth-metric-value">99.9%</div>
      </div>
    </div>
  </section>

  <section class="auth-form-panel">
    <div class="auth-form-bg-pattern"></div>

    <div class="auth-form-container relative z-10">
      <!-- Logo -->
      <div class="flex flex-col items-center mb-8">
        <div class="auth-form-logo">
          <i class="fa-solid fa-satellite-dish text-[18px]"></i>
        </div>
        <div class="text-[16px] font-semibold text-[#1A1A1A] tracking-tight mt-3">ArckOne</div>
        <div class="text-[10px] text-[#B5B0A8] tracking-[0.16em] mt-0.5">IOT PLATFORM</div>
      </div>

      <div class="auth-form-card">
        <!-- Header -->
        <div class="mb-8 text-center">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FAEEDA] border border-[#FAC775] mb-4">
            <i class="fa-solid fa-rocket text-[9px] text-[#854F0B]"></i>
            <span class="text-[10px] font-medium text-[#854F0B] tracking-wide uppercase">Get Started</span>
          </div>
          <h2 class="text-[28px] font-semibold tracking-tight text-[#1A1A1A] leading-tight">Create your account</h2>
          <p class="text-[13px] text-[#9E9891] mt-1.5">Set up your workspace in under a minute</p>
        </div>

        <%= render "devise/shared/error_messages", resource: resource %>

        <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form-fields" }) do |f| %>
          <!-- Email -->
          <div>
            <%= f.label :email, class: "auth-field-label" %>
            <div class="auth-input-wrap">
              <i class="fa-regular fa-envelope auth-input-icon"></i>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "auth-input auth-input-with-icon" %>
            </div>
          </div>

          <!-- Password -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <%= f.label :password, class: "auth-field-label mb-0" %>
              <% if @minimum_password_length %>
                <span class="text-[10px] text-[#B5B0A8] font-medium">Min <%= @minimum_password_length %> characters</span>
              <% end %>
            </div>
            <div class="auth-input-wrap">
              <i class="fa-solid fa-lock auth-input-icon"></i>
              <%= f.password_field :password, autocomplete: "new-password", placeholder: "Create a strong password", class: "auth-input auth-input-with-icon" %>
            </div>
          </div>

          <!-- Confirm Password -->
          <div>
            <%= f.label :password_confirmation, "Confirm password", class: "auth-field-label" %>
            <div class="auth-input-wrap">
              <i class="fa-solid fa-shield-halved auth-input-icon"></i>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Repeat your password", class: "auth-input auth-input-with-icon" %>
            </div>
          </div>

          <!-- Submit -->
          <div class="pt-2">
            <%= f.submit "Create account", class: "auth-submit-btn" %>
          </div>
        <% end %>

        <!-- Divider -->
        <div class="flex items-center gap-3 mt-7 mb-5">
          <div class="flex-1 h-px bg-[#E8E4DD]"></div>
          <span class="text-[10px] font-medium text-[#B5B0A8] tracking-widest uppercase">or</span>
          <div class="flex-1 h-px bg-[#E8E4DD]"></div>
        </div>

        <!-- Login link -->
        <p class="text-center text-[13px] text-[#6B6560]">
          Already have an account?
          <%= link_to "Sign in", new_session_path(resource_name), class: "font-semibold text-[#1A1A1A] hover:underline ml-1" %>
        </p>
      </div>

      <!-- Trust badges -->
      <div class="flex items-center justify-center gap-5 mt-6">
        <div class="auth-trust-badge">
          <i class="fa-solid fa-shield-halved"></i>
          <span>SSL Secured</span>
        </div>
        <div class="auth-trust-badge">
          <i class="fa-solid fa-lock"></i>
          <span>Encrypted</span>
        </div>
      </div>

      <p class="text-center text-[10px] text-[#B5B0A8] mt-4">
        By creating an account, you agree to our Terms of Service and Privacy Policy.
      </p>
    </div>
  </section>
</div>

<!-- tsParticles CDN -->
<script src="https://cdn.jsdelivr.net/npm/tsparticles-slim@2.12.0/tsparticles.slim.bundle.min.js"></script>
<script>
  document.addEventListener("DOMContentLoaded", function() {
    tsParticles.load("signup-particles", {
      fullScreen: { enable: false },
      background: { color: "transparent" },
      fpsLimit: 60,
      interactivity: {
        events: {
          onHover: { enable: true, mode: "grab" },
          resize: true
        },
        modes: {
          grab: { distance: 150, links: { opacity: 0.3 } }
        }
      },
      particles: {
        color: { value: ["#F7F5F1", "#E8E4DD", "#B5B0A8"] },
        links: {
          color: "#F7F5F1",
          distance: 130,
          enable: true,
          opacity: 0.08,
          width: 1
        },
        move: {
          enable: true,
          speed: 0.6,
          direction: "none",
          random: true,
          straight: false,
          outModes: { default: "bounce" }
        },
        number: {
          density: { enable: true, area: 900 },
          value: 70
        },
        opacity: {
          value: { min: 0.15, max: 0.5 },
          animation: {
            enable: true,
            speed: 0.8,
            minimumValue: 0.1,
            sync: false
          }
        },
        shape: { type: "circle" },
        size: {
          value: { min: 1.5, max: 4 },
          animation: {
            enable: true,
            speed: 1.5,
            minimumValue: 1,
            sync: false
          }
        }
      },
      detectRetina: true
    });
  });
</script>
