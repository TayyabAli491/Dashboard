<div class="page-wrap">
  <%= render "shared/nav" %>

  <main class="main-content">
    <div class="topbar">
      <div>
        <div class="mb-5">
          <%= link_to workspace_path(@workspace), class: "inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider text-[#6B6560] bg-[#E8E4DD]/50 hover:bg-[#E8E4DD] hover:text-[#1A1A1A] px-2.5 py-1.5 rounded-lg transition-colors border border-transparent hover:border-[#C8C3BB]" do %>
            <i class="fa-solid fa-arrow-left text-[9px]"></i> Back to <%= @workspace.name %>
          <% end %>
        </div>
        <div class="page-eyebrow">Payload Mapping</div>
        <h1 class="page-title">Stored <em>Schema</em></h1>
      </div>

      <div class="flex items-center gap-2">
        <%= link_to edit_workspace_payload_schema_path(@workspace), class: "btn-secondary" do %>
          <i class="fa-solid fa-pen"></i> Edit Schema
        <% end %>
      </div>
    </div>

    <div class="card p-0 overflow-hidden shadow-sm">
      <div class="card-accent teal"></div>
      <div class="p-6">
        <% fields = @payload_schema&.fields || [] %>

        <div class="flex items-center justify-between mb-5">
          <div class="text-[12px] font-semibold text-[#6B6560] uppercase tracking-widest">Definition</div>
          <div class="text-[11px] text-[#9E9891] font-medium">
            <span class="font-semibold text-[#1A1A1A]"><%= fields.length %></span> fields
          </div>
        </div>

        <% if fields.any? %>
          <div class="overflow-hidden rounded-xl border border-[#E8E4DD] bg-[#1A1A1A] shadow-inner">
            <pre class="text-[12px] font-mono leading-relaxed text-blue-100/90 overflow-x-auto selection:bg-blue-500/30 p-6"><%= JSON.pretty_generate(fields) %></pre>
          </div>
        <% else %>
          <div class="empty-state">
            <div class="empty-ring">
              <i class="fa-solid fa-diagram-project fa-2x"></i>
            </div>
            <div class="empty-title">No Schema Defined</div>
            <div class="empty-sub">Define a payload schema so telemetry packets can be mapped into fields.</div>
            <%= link_to edit_workspace_payload_schema_path(@workspace), class: "btn-primary w-fit mx-auto mt-2" do %>
              <i class="fa-solid fa-pen"></i> Define Schema
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</div>

