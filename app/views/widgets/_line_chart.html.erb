<%= render "widgets/widget_wrapper", widget: widget do %>
  <div class="line-chart-body">
    <canvas data-controller="line-chart"
            data-line-chart-fields-value="<%= widget['config']['fields'].to_json %>"
            data-line-chart-color-value="<%= widget['config']['color'] %>"></canvas>
  </div>
<% end %>
