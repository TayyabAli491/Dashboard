<div class="min-h-screen bg-gray-50 p-6">
  <div class="mx-auto max-w-7xl">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">
          <%= link_to @workspace.name, workspace_path(@workspace), class: "hover:text-gray-700" %>
          <span class="mx-1">/</span>
          <%= link_to "Sessions", workspace_sessions_path(@workspace), class: "hover:text-gray-700" %>
        </p>
        <h1 class="text-3xl font-bold text-gray-900"><%= @session.name %></h1>
      </div>
      <div>
        <% if @session.started_at.blank? %>
          <%= button_to "Start Session", session_path(@session), method: :patch, params: { session_state: "start" }, class: "bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg px-4 py-2" %>
        <% elsif @session.session_active? %>
          <%= button_to "End Session", session_path(@session), method: :patch, params: { session_state: "end" }, data: { turbo_confirm: "End this session now?" }, class: "bg-red-50 text-red-600 hover:bg-red-100 rounded-lg px-4 py-2" %>
        <% else %>
          <span class="inline-flex rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-700">Session completed</span>
        <% end %>
      </div>
    </div>

    <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-4">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
        <p class="text-xs text-gray-500">Status</p>
        <p class="mt-1 text-sm font-medium text-gray-900">
          <% if @session.session_active? %>
            Active
          <% elsif @session.session_completed? %>
            Completed
          <% else %>
            Not started
          <% end %>
        </p>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
        <p class="text-xs text-gray-500">Started At</p>
        <p class="mt-1 text-sm font-medium text-gray-900"><%= @session.started_at&.strftime("%b %-d, %Y %H:%M") || "-" %></p>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
        <p class="text-xs text-gray-500">Duration (s)</p>
        <p class="mt-1 text-sm font-medium text-gray-900"><%= @session.duration_in_seconds&.round(2) || "-" %></p>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4">
        <p class="text-xs text-gray-500">Telemetry Records</p>
        <p class="mt-1 text-sm font-medium text-gray-900"><%= @session.telemetry_record_count %></p>
      </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200 text-left text-gray-500">
            <th class="px-4 py-3 font-medium">Recorded At</th>
            <th class="px-4 py-3 font-medium">Field Values</th>
            <th class="px-4 py-3 font-medium">Raw</th>
          </tr>
        </thead>
        <tbody>
          <% @telemetry_records.each do |telemetry_record| %>
            <tr class="border-b border-gray-100 align-top">
              <td class="px-4 py-3 text-gray-900"><%= telemetry_record.recorded_at.strftime("%b %-d, %Y %H:%M:%S") %></td>
              <td class="px-4 py-3 text-gray-700">
                <% if @field_keys.any? %>
                  <div class="space-y-1">
                    <% @field_keys.each do |field_key| %>
                      <div>
                        <span class="font-medium text-gray-900"><%= field_key %>:</span>
                        <span><%= telemetry_record.value_for_field(field_key) %></span>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-gray-500">No payload schema fields defined</span>
                <% end %>
              </td>
              <td class="px-4 py-3">
                <details>
                  <summary class="cursor-pointer text-indigo-600 hover:text-indigo-700">Raw</summary>
                  <pre class="mt-2 max-w-md overflow-x-auto rounded bg-gray-50 p-2 text-xs text-gray-700"><%= JSON.pretty_generate(telemetry_record.raw_payload || {}) %></pre>
                </details>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @total_pages > 1 %>
      <div class="mt-6 flex items-center justify-between">
        <div>
          <% if @page > 1 %>
            <%= link_to "Previous", session_path(@session, page: @page - 1), class: "text-indigo-600 hover:text-indigo-700" %>
          <% end %>
        </div>
        <p class="text-sm text-gray-500">Page <%= @page %> of <%= @total_pages %></p>
        <div>
          <% if @page < @total_pages %>
            <%= link_to "Next", session_path(@session, page: @page + 1), class: "text-indigo-600 hover:text-indigo-700" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
