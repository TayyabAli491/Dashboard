<div class="min-h-screen bg-gray-50 p-6">
  <div class="mx-auto max-w-7xl">
    <div class="mb-6 flex items-center justify-between">
      <div>
        <p class="text-sm text-gray-500">
          <%= link_to @workspace.name, workspace_path(@workspace), class: "hover:text-gray-700" %>
          <span class="mx-1">/</span>
          Sessions
        </p>
        <h1 class="text-3xl font-bold text-gray-900">Sessions</h1>
      </div>
      <%= link_to "New Session", new_workspace_session_path(@workspace), class: "bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg px-4 py-2" %>
    </div>

    <% if @sessions.any? %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200 text-left text-gray-500">
              <th class="px-4 py-3 font-medium">Name</th>
              <th class="px-4 py-3 font-medium">Status</th>
              <th class="px-4 py-3 font-medium">Started At</th>
              <th class="px-4 py-3 font-medium">Duration</th>
              <th class="px-4 py-3 font-medium">Record Count</th>
              <th class="px-4 py-3 font-medium">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @sessions.each do |session| %>
              <tr class="border-b border-gray-100">
                <td class="px-4 py-3 text-gray-900"><%= session.name %></td>
                <td class="px-4 py-3">
                  <% if session.session_active? %>
                    <span class="inline-flex items-center gap-1 text-green-600 font-medium">
                      <span class="h-2 w-2 rounded-full bg-green-500"></span>
                      Active
                    </span>
                  <% elsif session.session_completed? %>
                    <span class="inline-flex rounded-full bg-gray-100 px-2 py-1 text-xs font-medium text-gray-700">Completed</span>
                  <% else %>
                    <span class="inline-flex rounded-full bg-amber-100 px-2 py-1 text-xs font-medium text-amber-700">Not started</span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-gray-700"><%= session.started_at&.strftime("%b %-d, %Y %H:%M") || "-" %></td>
                <td class="px-4 py-3 text-gray-700"><%= session.duration_in_seconds&.round(2) || "-" %></td>
                <td class="px-4 py-3 text-gray-700"><%= session.telemetry_record_count %></td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    <%= link_to "View", session_path(session), class: "text-indigo-600 hover:text-indigo-700" %>
                    <%= link_to "Edit", edit_session_path(session), class: "text-indigo-600 hover:text-indigo-700" %>
                    <%= button_to "Delete", session_path(session), method: :delete, data: { turbo_confirm: "Delete this session?" }, class: "text-red-600 hover:text-red-700 bg-transparent border-0 p-0" %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-10 text-center">
        <p class="text-lg font-medium text-gray-700">No sessions yet</p>
        <p class="mt-1 text-sm text-gray-500">Create your first data collection window for this workspace.</p>
      </div>
    <% end %>
  </div>
</div>
